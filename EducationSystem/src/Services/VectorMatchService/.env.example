# SQL Server ODBC connections. Install Microsoft ODBC Driver 18 first.
# Local Start-VectorMatchService.ps1 injects these from the ignored .NET
# development connection file, so they can remain empty in local .env.
VECTOR_ACADEMIC_DB_CONNECTION_STRING=
VECTOR_CAREER_DB_CONNECTION_STRING=

VECTOR_MODEL_NAME=sentence-transformers/multi-qa-MiniLM-L6-cos-v1
VECTOR_MODEL_DEVICE=cpu
VECTOR_ELIGIBLE_GPA_THRESHOLD=7.0
VECTOR_INDEX_TTL_SECONDS=900

# Required outside local development. Send this value in X-Internal-Api-Key.
VECTOR_INTERNAL_API_KEY=

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CareerDb": ""
  },
  "StudentJwt": {
    "Issuer": "EducationSystem.Identity",
    "Audience": "EducationSystem.StudentPortal",
    "SigningKey": "",
    "LifetimeMinutes": 15
  },
  "ManagementAuth": {
    "AllowDevelopmentBypass": false
  },
  "AcademicClient": {
    "BaseUrl": "http://localhost:5002"
  },
  "OutcomeStorage": {
    "RootPath": "",
    "MaxFileSizeBytes": 10485760,
    "MaxExpandedSizeBytes": 104857600,
    "MaxZipEntries": 5000
  },
  "LLM": {
    "Provider": "Gemini",
    "Model": "",
    "ApiKey": "",
    "TimeoutSeconds": 180,
    "MaxRetries": 2,
    "MaxRequestsPerBatch": 30,
    "MaxInputTokensPerRequest": 12000,
    "PromptVersion": "outcome-import-v1"
  }
}

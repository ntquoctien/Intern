# Identity and student portal APIs
VITE_IDENTITY_API_ORIGIN=http://localhost:5001

# AcademicService from Phase 2
VITE_ACADEMIC_API_ORIGIN=http://localhost:5002

# ExamService student endpoints
VITE_EXAM_API_ORIGIN=http://localhost:5003

# Keep "mock" for the standalone client-side demo. Switch to "live" to load
# resume context and approved internships from AcademicService.
VITE_RESUME_API_MODE=mock

# Placeholder for the future LLM/AI gateway. Phase 2 does not expose this API yet.
VITE_AI_API_ORIGIN=http://localhost:5005
VITE_AI_OPTIMIZE_MODE=mock

# Internship verification always uses the real CommunicationService.
VITE_COMMUNICATION_API_ORIGIN=http://localhost:5004
